{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensecstack.org/citadel/schemas/patrol_audit_output_v1.0.json",
  "title": "PATROL Audit Output v1.0",
  "description": "Schema for the audit output of the CITADEL PATROL verification intelligence.",
  "type": "object",
  "required": ["meta", "verdict", "integrity"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "project_id", "audit_id", "audit_type", "ts_utc", "mirror_source", "mirror_freshness_utc"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "project_id": { "type": "string", "enum": ["ABISSNET_TCL_001", "TRIA", "Portfolio_CRV_001_P01"] },
        "audit_id": { "type": "string", "format": "uuid" },
        "audit_type": { "type": "string", "enum": ["CONTINUOUS", "DEEP"] },
        "ts_utc": { "type": "string", "format": "date-time" },
        "mirror_source": { "type": "string" },
        "mirror_freshness_utc": { "type": "string", "format": "date-time" }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["outcome", "scope", "findings"],
      "properties": {
        "outcome": { "type": "string", "enum": ["VALID", "VALID_WITH_WARNINGS", "INVALID", "INCONCLUSIVE"] },
        "scope": {
          "type": "object",
          "required": ["audit_target", "record_count"],
          "properties": {
            "audit_target": {
              "type": "string",
              "enum": ["chain_integrity", "worm_consistency", "sod_compliance", "evidence_custody", "mirror_freshness", "full_deep"]
            },
            "date_range": {
              "type": "object",
              "properties": {
                "from": { "type": "string", "format": "date" },
                "to": { "type": "string", "format": "date" }
              }
            },
            "record_count": { "type": "integer", "minimum": 0 }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "check", "severity", "description"],
            "properties": {
              "finding_id": { "type": "string", "format": "uuid" },
              "check": { "type": "string", "description": "Which audit check produced this finding" },
              "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
              "description": { "type": "string" },
              "affected_records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["model", "record_id"],
                  "properties": {
                    "model": { "type": "string" },
                    "record_id": { "type": "integer" },
                    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  }
                }
              },
              "remediation": { "type": "string", "description": "Suggested corrective action" }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["audit_hash_sha256", "chain_anchor_id"],
      "properties": {
        "audit_hash_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "chain_anchor_id": { "type": "integer" }
      }
    }
  }
}
