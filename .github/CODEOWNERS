# OpenSecStack CODEOWNERS
# Each pattern below assigns review ownership for PRs touching matching
# paths. GitHub enforces these via branch protection.
#
# For the rationale, see docs/release-process.md and the
# `ownership` section of CONTRIBUTING.md.

# ── Global fallback ────────────────────────────────────────────────────
* @opensecstack/core-maintainers

# ── Platforms (built v1.0.0) ───────────────────────────────────────────
/apiguard/     @opensecstack/apiguard-maintainers
/nis2compass/  @opensecstack/nis2compass-maintainers
/citadel/      @opensecstack/citadel-maintainers @opensecstack/security-team
/irflow/       @opensecstack/irflow-maintainers
/threatflow/   @opensecstack/threatflow-maintainers

# ── Platforms (scaffolded) ─────────────────────────────────────────────
/cyberpath/    @opensecstack/cyberpath-maintainers

# ── Platforms (planned) ────────────────────────────────────────────────
# When these directories land, uncomment and assign.
# /openscrub/    @opensecstack/openscrub-maintainers
# /securelab/    @opensecstack/securelab-maintainers
# /opencsirt/    @opensecstack/opencsirt-maintainers

# ── SDK ────────────────────────────────────────────────────────────────
# Cross-platform impact — all platform leads must sign off.
/sdk/          @opensecstack/core-maintainers
/sdk/go/       @opensecstack/core-maintainers
/sdk/python/   @opensecstack/core-maintainers
/sdk/typescript/ @opensecstack/core-maintainers
/sdk/rust/     @opensecstack/core-maintainers
/sdk/go/password/        @opensecstack/security-team
/sdk/python-password/    @opensecstack/security-team

# ── Website ────────────────────────────────────────────────────────────
/website/      @opensecstack/website-maintainers

# ── Deployment & infrastructure ────────────────────────────────────────
/deploy/       @opensecstack/core-maintainers
/deploy/k8s/   @opensecstack/core-maintainers

# ── Security-sensitive files — require security team sign-off ──────────
