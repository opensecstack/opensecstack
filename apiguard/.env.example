# =============================================================================
# APIGuard Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# Do NOT commit your .env file to version control.
#
# All APIGUARD_* variables below map onto internal/config/config.go's Config
# struct via viper (dots in mapstructure tags become underscores, e.g.
# db.max_open_conns -> APIGUARD_DB_MAX_OPEN_CONNS). Environment variables
# override apiguard.yaml, and CLI flags override environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets (REQUIRED in production)
# -----------------------------------------------------------------------------

# PostgreSQL superuser password used by docker-compose. Min 16 chars.
POSTGRES_PASSWORD=

# Redis authentication password used by docker-compose. Min 16 chars.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the APIGuard API server listens on.
APIGUARD_PORT=8080

# Log verbosity level: debug, info, warn, error.
APIGUARD_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgres://user:password@host:port/dbname?sslmode=disable
APIGUARD_DB_URL=postgres://apiguard:changeme@localhost:5432/apiguard?sslmode=disable

# Maximum number of open connections to the database.
APIGUARD_DB_MAX_OPEN_CONNS=25

# Maximum number of idle connections kept in the pool.
APIGUARD_DB_MAX_IDLE_CONNS=5

# Maximum amount of time a connection may be reused (e.g. 5m, 1h).
APIGUARD_DB_CONN_MAX_LIFETIME=5m

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection string used for caching and job queues.
APIGUARD_REDIS_URL=redis://localhost:6379

# Redis password, if Redis requires authentication.
# APIGUARD_REDIS_PASSWORD=

# Redis logical database index.
APIGUARD_REDIS_DB=0

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# Secret key used to sign JWT tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
APIGUARD_AUTH_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Legacy two-slot rotation: previous JWT secret still accepted for verification.
# APIGUARD_AUTH_PREVIOUS_JWT_SECRET=

# Preferred multi-secret rotation list (comma-separated, up to 3, index 0 = active
# signing key). Takes precedence over APIGUARD_AUTH_JWT_SECRET when set.
# APIGUARD_AUTH_JWT_SECRETS=

# Duration before issued JWT tokens expire (e.g., 1h, 24h, 7d).
APIGUARD_AUTH_TOKEN_EXPIRY=24h

# Enable pre-shared API key authentication via POST /api/v1/auth/token.
APIGUARD_AUTH_ENABLE_API_KEYS=false

# Pre-shared API keys accepted by POST /api/v1/auth/token (comma-separated).
# APIGUARD_AUTH_API_KEYS=

# Base URL of the sinauth OIDC issuer used for RS256 SSO token verification.
APIGUARD_AUTH_SINAUTH_URL=http://localhost:8100

# -----------------------------------------------------------------------------
# Scanner
# -----------------------------------------------------------------------------

# Per-request timeout for a single scan operation (e.g. 30s, 5m).
APIGUARD_SCANNER_TIMEOUT=5m

# Number of concurrent scan workers.
APIGUARD_SCANNER_CONCURRENCY=10

# Maximum allowed OpenAPI spec file size in megabytes.
APIGUARD_SCANNER_MAX_SPEC_SIZE=10

# Requests per second sent to the target API; 0 = unlimited.
APIGUARD_SCANNER_RATE_LIMIT=0

# Skip TLS certificate verification when scanning. Development only.
APIGUARD_SCANNER_TLS_SKIP_VERIFY=false

# Path to a directory of *.yaml custom rule files. Empty = no custom rules.
# APIGUARD_SCANNER_CUSTOM_RULES_DIR=

# -----------------------------------------------------------------------------
# Report
# -----------------------------------------------------------------------------

# Default report output format: json, html, sarif.
APIGUARD_REPORT_DEFAULT_FORMAT=json

# Directory where generated scan reports are stored.
APIGUARD_REPORT_OUTPUT_DIR=./reports

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------

# Whether the bundled web dashboard is served by the API server.
APIGUARD_DASHBOARD_ENABLED=true

# Directory containing the built dashboard static assets.
APIGUARD_DASHBOARD_STATIC_DIR=./web/dist

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Allowed CORS origins (comma-separated). Empty (default) denies all
# cross-origin requests. Use "*" to permit all origins (development only).
# APIGUARD_CORS_ORIGINS=https://app.example.com,https://other.example.com

# -----------------------------------------------------------------------------
# Rate limiter
# -----------------------------------------------------------------------------

# Upstream proxy IPs/CIDRs whose X-Forwarded-For header is trusted
# (comma-separated). Empty (default) ignores X-Forwarded-For entirely.
# APIGUARD_RATELIMIT_TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# Number of trusted proxy hops to skip when reading the client IP from
# X-Forwarded-For. Default: 1 (single-proxy setup).
APIGUARD_RATELIMIT_TRUSTED_PROXY_DEPTH=1

# -----------------------------------------------------------------------------
# CITADEL Integration (optional)
# -----------------------------------------------------------------------------
# APIGuard is an HTTP client of CITADEL — every scan is submitted to MARSHAL
# for a governance decision, and audit events are forwarded to the WORM chain.
# Leaving APIGUARD_CITADEL_URL unset disables the CITADEL client entirely
# (all calls become no-ops). See docs/configuration.md#citadel-integration.

# Base URL of the CITADEL API. Empty disables the CITADEL client.
# APIGUARD_CITADEL_URL=http://citadel-api:8099

# HMAC connector key identifier, sent as the X-CITADEL-KEY header.
# APIGUARD_CITADEL_KEY_ID=

# HMAC-SHA256 signing secret used to compute X-CITADEL-SIG. Never logged.
# APIGUARD_CITADEL_KEY_SECRET=

# Identifies this apiguard instance as a CITADEL project; used as project_id
# in Kerkese payloads and WORM events. Default: apiguard
APIGUARD_CITADEL_PROJECT_ID=apiguard

# When true, MARSHAL evaluate calls set dry_run=true — CITADEL logs the
# decision but never blocks a scan. Default: true (safe for initial rollout).
APIGUARD_CITADEL_DRY_RUN=true

# HMAC-SHA256 shared secret used to verify inbound webhook events from
# CITADEL. When empty, the webhook endpoint rejects all requests with 401.
# APIGUARD_CITADEL_WEBHOOK_SECRET=

# When true, requires a genuine second authenticated user to approve a scan
# (POST /api/v1/scans/{id}/approve) before it launches, instead of the
# placeholder Verifier. Default: false (today's immediate-launch behavior).
APIGUARD_CITADEL_REQUIRE_APPROVAL=false

# -----------------------------------------------------------------------------
# Rust binary paths (optional — defaults search $PATH)
# -----------------------------------------------------------------------------

# Explicit path to the compiled apiguard-parser binary.
# APIGUARD_PARSER_BIN=/usr/local/bin/apiguard-parser

# Explicit path to the compiled apiguard-testgen binary.
# APIGUARD_TESTGEN_BIN=/usr/local/bin/apiguard-testgen
