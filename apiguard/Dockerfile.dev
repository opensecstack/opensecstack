# Dev image with Air hot-reload. BUILD CONTEXT = repo root (../ from deploy),
# because go.mod uses `replace => ../sdk/...` which must resolve at build time.
# Source (cmd/internal) is volume-mounted over /src/apiguard in docker-compose.
FROM golang:1.25-alpine
RUN apk add --no-cache git ca-certificates curl && \
    go install github.com/air-verse/air@latest
WORKDIR /src
COPY sdk/go ./sdk/go
COPY apiguard/ ./apiguard/
WORKDIR /src/apiguard
RUN go mod download
EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
