# SIN Community — environment configuration template
# Copy to .env and fill in real values. Never commit .env.
# All vars marked DEV-ONLY must be changed before deploying to production.

# ─── Server ──────────────────────────────────────────────────────────────────
# Listen address for the HTTP server
COMMUNITY_HTTP_ADDR=:8090

# Logical node name (useful in multi-node / log aggregation setups)
COMMUNITY_NODE=community-0

# Set to true only for local development — skips secret validation
COMMUNITY_DEV_MODE=false          # set true only in dev

# ─── Database ────────────────────────────────────────────────────────────────
# Password for the PostgreSQL `sin` user (used as DB_PASSWORD in docker-compose)
DB_PASSWORD=changeme              # CHANGE IN PRODUCTION

# Full PostgreSQL connection string (docker-compose sets this automatically)
COMMUNITY_DB_URL=postgres://sin:changeme@localhost:5432/sin?sslmode=disable

# Max number of connections in the DB pool
COMMUNITY_DB_MAX_CONNS=16

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens — must be >= 32 bytes in production
COMMUNITY_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes  # CHANGE IN PRODUCTION

# Issuer claim embedded in JWT tokens
COMMUNITY_JWT_ISSUER=community

# How long access tokens remain valid (Go duration string: 12h, 24h, etc.)
COMMUNITY_TOKEN_TTL=12h

# Password hashing pepper — must not contain "do-not-use-in-prod" in production
COMMUNITY_PASSWORD_PEPPER=replace-with-a-random-pepper-value  # CHANGE IN PRODUCTION

# ─── Registration ────────────────────────────────────────────────────────────
# Require an invite code to register (true/false)
COMMUNITY_INVITE_ONLY=false

# Comma-separated list of allowed email domains (leave empty to allow all)
COMMUNITY_ALLOWED_EMAIL_DOMAINS=

# Seed/bootstrap users: comma-separated "username:role:password-hash" entries
# Roles: viewer | author | moderator | admin
# Example: admin:admin:$2a$12$...bcrypt-hash...
# Default dev value — CHANGE OR CLEAR IN PRODUCTION
COMMUNITY_USERS=admin:admin:$2a$12$placeholder-replace-with-real-bcrypt-hash

# ─── Site ────────────────────────────────────────────────────────────────────
# Public-facing URL of the site (used in emails, OAuth callbacks, etc.)
# Note: the config package reads this as SITE_URL (no COMMUNITY_ prefix)
SITE_URL=https://sin.to
# Alias kept here for documentation purposes:
# COMMUNITY_SITE_URL — maps to SITE_URL in config.go

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Directory where uploaded images are stored (mapped to a Docker volume in compose)
# Note: the config package reads this as UPLOAD_DIR (no COMMUNITY_ prefix)
UPLOAD_DIR=./uploads
# Alias kept here for documentation purposes:
# COMMUNITY_UPLOAD_DIR — maps to UPLOAD_DIR in config.go

# ─── Meilisearch ─────────────────────────────────────────────────────────────
# Master key shared by the Meilisearch service and the app
MEILI_MASTER_KEY=replace-with-a-strong-meilisearch-master-key  # CHANGE IN PRODUCTION

# Meilisearch base URL (docker-compose sets this to http://meilisearch:7700)
MEILISEARCH_URL=http://localhost:7700

# API key the app uses — typically the same as MEILI_MASTER_KEY
MEILISEARCH_KEY=replace-with-a-strong-meilisearch-master-key   # CHANGE IN PRODUCTION

# ─── SMTP ────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable all outgoing email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@sin.to
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@sin.to

# Enable weekly digest emails (true/false)
DIGEST_ENABLED=true

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://sin.to/api/v1/auth/github/callback

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sin.to/api/v1/auth/google/callback

# ─── Citadel integration ─────────────────────────────────────────────────────
# Base URL for the Citadel API (leave empty to disable)
COMMUNITY_CITADEL_API_URL=

# Key ID sent in Citadel requests
COMMUNITY_CITADEL_KEY_ID=community-1

# Comma-separated HMAC secrets for verifying Citadel webhook payloads
COMMUNITY_CITADEL_HMAC_SECRETS=

# Dry-run mode: log Citadel calls without actually sending them
COMMUNITY_CITADEL_DRY_RUN=true   # set false in production when Citadel is configured

# ─── Push notifications ───────────────────────────────────────────────────────
# VITE_VAPID_PUBLIC_KEY belongs in web/.env, not here.
# Generate a VAPID key pair and place the public key in web/.env.

# ─── Build arg (docker compose build) ────────────────────────────────────────
VERSION=dev
