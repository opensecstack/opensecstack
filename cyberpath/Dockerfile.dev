# Dev image with Air hot-reload. BUILD CONTEXT = repo root (../ from deploy),
# because go.mod uses `replace => ../sdk/...` which must resolve at build time.
# Source (cmd/internal) is volume-mounted over /src/cyberpath in docker-compose.
FROM golang:1.25-alpine
RUN apk add --no-cache git ca-certificates curl && \
    go install github.com/air-verse/air@v1.67.1
WORKDIR /src
COPY sdk/go ./sdk/go
COPY cyberpath/ ./cyberpath/
WORKDIR /src/cyberpath
RUN go mod download
EXPOSE 8086
CMD ["air", "-c", ".air.toml"]
