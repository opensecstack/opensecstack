# APIGuard
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APIGUARD_JWT_SECRET=

# NIS2 Compass
NIS2_DB_PASSWORD=
NIS2_SECRET_KEY=
NIS2_JWT_SECRET=

# sinauth (SSO identity provider)
# SINAUTH_DB_PASSWORD must match the role password in scripts/init-sinauth-db.sql (changeme).
SINAUTH_DB_PASSWORD=
# Issuer URL: must equal the URL platform backends use to reach sinauth AND the
# token `iss`. For internal-only compose use http://sinauth-api:8100; for a public
# deployment use the externally-resolvable HTTPS origin (e.g. https://auth.sin.to).
SINAUTH_ISSUER=
# Public origin of the sinauth login SPA (sinauth-web), used for the OAuth popup.
SINAUTH_SITE_URL=
# Comma-separated browser origins allowed to call the token endpoint (each platform web).
SINAUTH_ALLOWED_ORIGINS=
# Optional — signing key id advertised in the JWKS (default sinauth-1).
SINAUTH_SIGNING_KEY_ID=

# CITADEL (optional — set CITADEL_API_KEY to enable authenticated audit forwarding)
# CITADEL_API_URL is hard-wired to http://citadel-api:8099 in docker-compose.yml;
# override here only if you run CITADEL on a different host/port.
CITADEL_API_URL=
CITADEL_API_KEY=
