# APIGuard
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APIGUARD_JWT_SECRET=

# NIS2 Compass
NIS2_DB_PASSWORD=
NIS2_SECRET_KEY=
NIS2_JWT_SECRET=

# CITADEL (optional — set CITADEL_API_KEY to enable authenticated audit forwarding)
# CITADEL_API_URL is hard-wired to http://citadel-api:8099 in docker-compose.yml;
# override here only if you run CITADEL on a different host/port.
CITADEL_API_URL=
CITADEL_API_KEY=
