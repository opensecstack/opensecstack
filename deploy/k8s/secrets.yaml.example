# secrets.yaml.example — DO NOT commit real values.
# Copy this file to secrets.yaml, fill in base64-encoded values, then apply.
#
# To base64-encode a value:
#   echo -n 'your-secret-value' | base64
#
# Or use the kubectl imperative approach (recommended, avoids committing secrets):
#   See deploy/k8s/README.md for the full kubectl create secret commands.

---
apiVersion: v1
kind: Secret
metadata:
  name: opensecstack-db-secrets
  namespace: opensecstack
type: Opaque
data:
  # PostgreSQL superuser password (used by the postgres container itself)
  POSTGRES_PASSWORD: Y2hhbmdlbWU=        # base64("changeme") — REPLACE

  # Password for the nis2compass DB user
  NIS2_DB_PASSWORD: Y2hhbmdlbWU=         # base64("changeme") — REPLACE

  # Password for the apiguard DB user (same as POSTGRES_PASSWORD when using
  # the shared postgres instance with POSTGRES_USER=apiguard)
  APIGUARD_DB_PASSWORD: Y2hhbmdlbWU=     # base64("changeme") — REPLACE

---
apiVersion: v1
kind: Secret
metadata:
  name: opensecstack-app-secrets
  namespace: opensecstack
type: Opaque
data:
  # JWT signing secret for APIGuard (minimum 32 characters)
  APIGUARD_JWT_SECRET: Y2hhbmdlLXRoaXMtdG8tYS1yYW5kb20tc3RyaW5nLWF0LWxlYXN0LTMyLWNoYXJz  # REPLACE

  # JWT signing secret for NIS2 Compass (minimum 32 characters)
  NIS2_JWT_SECRET: Y2hhbmdlLXRoaXMtdG8tYS1yYW5kb20tc3RyaW5nLWF0LWxlYXN0LTMyLWNoYXJz     # REPLACE

  # Flask/app secret key for NIS2 Compass
  NIS2_SECRET_KEY: Y2hhbmdlLXRoaXMtdG8tYS1yYW5kb20tc3RyaW5nLWF0LWxlYXN0LTMyLWNoYXJz    # REPLACE

  # Redis password
  REDIS_PASSWORD: Y2hhbmdlbWU=           # base64("changeme") — REPLACE
