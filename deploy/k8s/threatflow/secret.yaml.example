# ThreatFlow Kubernetes Secret — copy to secret.yaml and fill in values.
# NEVER commit the real secret.yaml to version control.
#
# Or create via CLI:
#   kubectl create secret generic threatflow-secrets \
#     --namespace opensecstack \
#     --from-literal=database-url='postgres://threatflow:SECRET@postgres:5432/threatflow?sslmode=verify-full' \
#     --from-literal=citadel-key-id='tf-connector-key' \
#     --from-literal=citadel-key-secret='your-hmac-secret'

apiVersion: v1
kind: Secret
metadata:
  name: threatflow-secrets
  namespace: opensecstack
  labels:
    app: threatflow
    app.kubernetes.io/part-of: opensecstack
type: Opaque
stringData:
  database-url: "postgres://threatflow:CHANGE_ME@postgres:5432/threatflow?sslmode=verify-full"
  citadel-key-id: "tf-connector-key"
  citadel-key-secret: "CHANGE_ME"
