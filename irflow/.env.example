# IRFlow configuration — copy to `.env` or export these variables before running.
# Every setting has a sensible default; only DB credentials and the auth secret
# are strictly required for a non-dev deployment.

# ---------- Server ----------
IRFLOW_SERVER_HOST=0.0.0.0
IRFLOW_SERVER_PORT=8083
IRFLOW_SERVER_READ_TIMEOUT=15s
IRFLOW_SERVER_WRITE_TIMEOUT=15s

# ---------- Database ----------
IRFLOW_DB_HOST=localhost
IRFLOW_DB_PORT=5432
IRFLOW_DB_NAME=irflow
IRFLOW_DB_USER=irflow
IRFLOW_DB_PASSWORD=
IRFLOW_DB_SSL_MODE=disable

# ---------- Auth (JWT — Phase 5) ----------
# Set IRFLOW_AUTH_SECRET to enable JWT enforcement. Leaving it empty (or
# setting IRFLOW_AUTH_DEV_MODE=true) disables the middleware with a Warn log.
# NEVER leave this empty in production.
IRFLOW_AUTH_SECRET=
IRFLOW_AUTH_TOKEN_TTL=8h
IRFLOW_AUTH_ISSUER=irflow
IRFLOW_AUTH_DEV_MODE=false

# Server-side pepper used by auth.NewHasher when hashing API keys / user
# passwords via sdk/go/password. Must be >= 16 bytes of random entropy
# (generate with: openssl rand -base64 24). Treat it like a TLS private
# key — never commit, rotate via a secret manager, and be aware that
# losing it invalidates every stored hash.
IRFLOW_AUTH_PEPPER=

# ---------- CITADEL (governance — Phase 4) ----------
# Set KEY_SECRET to enable MARSHAL evaluation + WORM emission. Empty means
# IRFlow runs "local-only": actions are stored without governance checks.
IRFLOW_CITADEL_API_URL=http://localhost:8082
IRFLOW_CITADEL_KEY_ID=
IRFLOW_CITADEL_KEY_SECRET=
IRFLOW_CITADEL_PROJECT_ID=
IRFLOW_CITADEL_DRY_RUN=true

# ---------- NIS2 Compass (Art. 23 notification — Phase 4) ----------
# Requires API_KEY + ASSESSMENT_ID. MEASURE_REF defaults to "b" for Article
# 21(2)(b) Incident Handling. Empty values disable NIS2 notifications.
IRFLOW_NIS2_API_URL=http://localhost:8081
IRFLOW_NIS2_API_KEY=
IRFLOW_NIS2_ASSESSMENT_ID=
IRFLOW_NIS2_MEASURE_REF=b

# ---------- Webhooks (Phase 3) ----------
# Shared fallback secret. Per-source secrets below take precedence.
IRFLOW_WEBHOOK_SECRET=
IRFLOW_WEBHOOK_APIGUARD_SECRET=
IRFLOW_WEBHOOK_CITADEL_SECRET=
IRFLOW_WEBHOOK_THREATFLOW_SECRET=
IRFLOW_WEBHOOK_CALLBACK_URL=
IRFLOW_WEBHOOK_MAX_BODY_SIZE=1048576
IRFLOW_WEBHOOK_CLOCK_SKEW_TOLERANCE=5m

# ---------- Integration testing ----------
# Used by `make test-integration`. Matches the docker-compose.test.yml service.
IRFLOW_TEST_DB_URL=postgres://irflow:irflow_test@localhost:54832/irflow_test?sslmode=disable
