# OpenCSIRT — environment configuration template
# Copy to .env and fill in. Never commit .env.
#
# Source of truth: internal/config/config.go.

# --- API server ---
OPENCSIRT_HTTP_ADDR=:8088
# Free-form node identifier embedded in CITADEL events. Defaults to
# "opencsirt-0" if unset.
OPENCSIRT_NODE=opencsirt-0
# Set 1/true to relax validation for local UI work. Never set in production.
OPENCSIRT_DEV_MODE=true                # DEV-ONLY

# --- Database ---
# Required outside dev mode (validated at startup).
OPENCSIRT_DB_URL=postgres://opencsirt:opencsirt@postgres:5432/opencsirt?sslmode=disable
OPENCSIRT_DB_MAX_CONNS=16

# --- Auth (JWT issuance) ---
# Required (>=32 bytes outside dev mode). Generate with:
#   openssl rand -base64 32
# Single value; comma-separated rotation is not supported in v1.0.0
# (the auth package accepts multiple secrets internally, but the env
# loader takes one).
OPENCSIRT_JWT_SECRET=dev-secret-do-not-use-in-prod-min-32-bytes-pad   # DEV-ONLY
OPENCSIRT_JWT_ISSUER=opencsirt
OPENCSIRT_TOKEN_TTL=12h

# --- Login issuer (operator credentials) ---
# Format: comma-separated  user:role:sha256hex
# Roles: viewer | external_peer | analyst | operator | csirt_lead | admin
#
# Generate the hash with:
#   printf '%s' "${OPENCSIRT_PASSWORD_PEPPER}:<plaintext>" | sha256sum
#
# Worked example for password "operator" against the dev pepper below:
#   printf '%s' 'dev-pepper-do-not-use-in-prod:operator' | sha256sum
#   → 40a487e69bfd2b64adc205cdd1f91de6e85a1aeb309f9bde4dc4e780c131cd26
OPENCSIRT_USERS=operator:csirt_lead:40a487e69bfd2b64adc205cdd1f91de6e85a1aeb309f9bde4dc4e780c131cd26   # DEV-ONLY

# Required outside dev mode. Pepper containing the literal string
# "do-not-use-in-prod" is rejected at startup.
OPENCSIRT_PASSWORD_PEPPER=dev-pepper-do-not-use-in-prod   # DEV-ONLY

# --- CITADEL evidence emitter ---
OPENCSIRT_CITADEL_API_URL=
# Comma-separated list = rotation slots (primary,next,previous).
OPENCSIRT_CITADEL_HMAC_SECRETS=
OPENCSIRT_CITADEL_KEY_ID=opencsirt-1
# DEFAULT IS true — events are logged but NOT POSTed. Production
# deployments MUST set this to false.
OPENCSIRT_CITADEL_DRY_RUN=true                            # DEV-ONLY

# --- Outbox sweeper ---
OPENCSIRT_OUTBOX_TICK=10s

# --- ThreatFlow IOC ingest ---
OPENCSIRT_THREATFLOW_API_URL=
OPENCSIRT_THREATFLOW_API_KEY=
OPENCSIRT_THREATFLOW_INTERVAL=15m

# --- NIS2 Compass notifier ---
OPENCSIRT_NIS2COMPASS_API_URL=

# --- IRFlow inbound webhook ---
# HMAC-SHA256 secret shared with IRFlow.
# When unset, the webhook endpoint rejects every request.
OPENCSIRT_IRFLOW_WEBHOOK_SECRET=
# When true, only low/medium/high/critical severity labels from IRFlow are accepted;
# unknown labels are rejected with 400. When false, unknown severity maps to "low".
OPENCSIRT_IRFLOW_STRICT_SEVERITY=false

# --- VertGuard CVE subscriber ---
OPENCSIRT_VERTGUARD_API_URL=
OPENCSIRT_VERTGUARD_API_KEY=

# --- Python advisory subsystem ---
# When unreachable, OpenCSIRT falls back to NoopClient and incident
# triage continues without CSAF generation (advisories block).
OPENCSIRT_ADVISORY_SERVICE_URL=http://advisory:8089
OPENCSIRT_ADVISORY_SERVICE_JWT=
