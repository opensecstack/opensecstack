{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/oasis-tcs/csaf/master/csaf_2.0/json_schema/csaf_schema.json",
  "title": "CSAF 2.0 schema placeholder",
  "description": "Placeholder — replace with the full upstream schema from https://raw.githubusercontent.com/oasis-tcs/csaf/master/csaf_2.0/json_schema/csaf_schema.json before going to production.",
  "type": "object",
  "required": ["document"],
  "properties": {
    "document": {
      "type": "object",
      "required": ["category", "csaf_version", "title", "publisher", "tracking", "distribution"],
      "properties": {
        "category":     { "type": "string" },
        "csaf_version": { "type": "string", "enum": ["2.0"] },
        "title":        { "type": "string", "minLength": 1 },
        "publisher": {
          "type": "object",
          "required": ["category", "name", "namespace"],
          "properties": {
            "category":  { "type": "string" },
            "name":      { "type": "string" },
            "namespace": { "type": "string" }
          }
        },
        "tracking": {
          "type": "object",
          "required": ["id", "status", "version", "initial_release_date", "current_release_date", "revision_history"],
          "properties": {
            "id":                   { "type": "string", "minLength": 1 },
            "status":               { "type": "string", "enum": ["draft", "final", "interim"] },
            "version":              { "type": "string" },
            "initial_release_date": { "type": "string" },
            "current_release_date": { "type": "string" },
            "revision_history":     { "type": "array", "minItems": 1 }
          }
        },
        "distribution": {
          "type": "object",
          "required": ["tlp"],
          "properties": {
            "tlp": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string", "enum": ["CLEAR", "GREEN", "AMBER", "RED"] }
              }
            }
          }
        }
      }
    },
    "product_tree":    { "type": "object" },
    "vulnerabilities": { "type": "array" }
  }
}
