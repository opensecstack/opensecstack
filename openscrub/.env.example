# OpenScrub — environment configuration template
# Copy to .env and fill in. Never commit .env.

# --- API server ---
OPENSCRUB_HTTP_ADDR=:8087
OPENSCRUB_LOG_LEVEL=info
# Issuer name embedded in minted JWTs.
OPENSCRUB_JWT_ISSUER=openscrub
# Set 1/true to relax auth for local UI work. Never set in production.
OPENSCRUB_DEV_MODE=false

# --- Database ---
# Required — docker-compose refuses to start if unset.
# Generate with: openssl rand -base64 24
OPENSCRUB_DB_PASSWORD=
OPENSCRUB_DB_URL=postgres://openscrub:${OPENSCRUB_DB_PASSWORD}@postgres:5432/openscrub?sslmode=disable
OPENSCRUB_DB_MAX_CONNS=16

# --- Auth (JWT issuance) ---
# Required — docker-compose refuses to start if unset.
# Generate with: openssl rand -base64 32
# Comma-separated list = rotation slots (primary,next,previous).
OPENSCRUB_JWT_SECRET=
OPENSCRUB_TOKEN_TTL=1h

# --- Login issuer (operator credentials) ---
# Required for /api/v1/auth/login. Without it the endpoint returns
# 503 issuer_disabled and operators must mint JWTs out-of-band against
# OPENSCRUB_JWT_SECRET.
#
# Format: comma-separated user:role:sha256hex.
# Generate the hash with:
#   echo -n "${OPENSCRUB_PASSWORD_PEPPER}:<plaintext>" | sha256sum
# Example: operator-iuni:operator:9a7f1b…,readonly:readonly:31ac…
OPENSCRUB_USERS=
# Required — pepper mixed into every credential hash. Compose refuses
# to start if unset. Pick anything ≥32 bytes from a CSPRNG.
OPENSCRUB_PASSWORD_PEPPER=

# --- Dataplane ---
# Transport between the API and the dataplane process.
#   noop — no-op (dev / unit tests; rules never reach BPF maps)
#   uds  — Unix-socket RPC (production)
OPENSCRUB_DATAPLANE_TRANSPORT=uds
OPENSCRUB_DATAPLANE_SOCKET=/run/openscrub/dataplane.sock

# --- Network interface for XDP attach ---
OPENSCRUB_IFACE=eth0
# attach mode: drv | skb | hw
# Default `skb` so the dev compose stack works on Docker-Desktop and
# generic-XDP NIC drivers. Production Helm values default to `drv`.
OPENSCRUB_XDP_MODE=skb

# --- ThreatFlow IOC puller ---
OPENSCRUB_THREATFLOW_API_URL=https://threatflow.internal
OPENSCRUB_THREATFLOW_TOKEN=
OPENSCRUB_THREATFLOW_INTERVAL=15m

# --- CITADEL evidence emitter ---
OPENSCRUB_CITADEL_API_URL=https://citadel.internal
# Single-key knob (legacy). For rotation use OPENSCRUB_CITADEL_HMAC_SECRETS
# (comma-separated: primary,next,previous) and the matching KEY_IDS list.
OPENSCRUB_CITADEL_HMAC_SECRET=
OPENSCRUB_CITADEL_HMAC_SECRETS=
OPENSCRUB_CITADEL_KEY_ID=
OPENSCRUB_CITADEL_KEY_IDS=
OPENSCRUB_CITADEL_SOURCE=openscrub
# Set 1/true to skip the actual POST and just log the would-be event.
OPENSCRUB_CITADEL_DRY_RUN=false
# Free-form node identifier embedded in every emitted event. Defaults
# to the OS hostname.
OPENSCRUB_NODE=

# --- Mitigation gating ---
# Minimum dwell time before a flapping mitigation is emitted to CITADEL.
OPENSCRUB_MITIGATION_MIN_DURATION=5s

# --- Prometheus exposition ---
# Counters are served on the main HTTP port at /api/v1/metrics with
# JWT auth. There is no separate metrics listener — provision a
# long-lived "readonly" JWT for the scraper instead.
