# Dev image with Air hot-reload. BUILD CONTEXT = repo root (../ from deploy),
# because go.mod uses `replace => ../sdk/...` which must resolve at build time.
# Source (cmd/internal) is volume-mounted over /src/openscrub in docker-compose.
# eBPF/XDP data plane is stubbed in dev — no root/Linux kernel required.
FROM golang:1.25-alpine
RUN apk add --no-cache git ca-certificates curl && \
    go install github.com/air-verse/air@v1.67.1
WORKDIR /src
COPY sdk/go ./sdk/go
COPY openscrub/ ./openscrub/
WORKDIR /src/openscrub
RUN go mod download
EXPOSE 8087
CMD ["air", "-c", ".air.toml"]
