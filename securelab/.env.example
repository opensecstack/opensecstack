# SecureLab Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# SAFETY: All attack simulations run inside isolated Docker environments.
# SECURELAB_CITADEL_DRY_RUN defaults to true — set to false only on
# a validated, isolated test environment.

# ── HTTP Server ───────────────────────────────────────────────────────────────

# Address and port the HTTP API listens on.
# Default: 127.0.0.1:8080 (localhost only).
# Do NOT change to 0.0.0.0 without TLS termination and authentication.
SECURELAB_HTTP_ADDR=127.0.0.1:8080

# Enable development mode: verbose logging, relaxed CORS, hot reload hints.
# Must be false in any environment that can reach real systems.
SECURELAB_DEV_MODE=false

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgres://user:password@host:port/dbname?sslmode=require
SECURELAB_DB_URL=postgres://securelab:changeme@localhost:5432/securelab?sslmode=disable

# ── Authentication ────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWT tokens.
# Minimum 32 characters. Generate with: openssl rand -hex 32
SECURELAB_JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# JWT token expiry duration.
SECURELAB_JWT_EXPIRY=24h

# ── CITADEL Integration ───────────────────────────────────────────────────────

# CITADEL API base URL. Receives securelab.run_completed events.
SECURELAB_CITADEL_URL=https://citadel.internal

# HMAC secret for signing CITADEL event payloads.
SECURELAB_CITADEL_HMAC_SECRET=change-this-citadel-hmac-secret

# Dry run mode: when true, events are logged but NOT sent to CITADEL.
# Keep true until you have a validated CITADEL endpoint.
SECURELAB_CITADEL_DRY_RUN=true

# ── OpenScrub Integration ─────────────────────────────────────────────────────

# OpenScrub API base URL for detection validation polling.
SECURELAB_OPENSCRUB_URL=https://openscrub.internal

# API key or HMAC secret for OpenScrub.
SECURELAB_OPENSCRUB_API_KEY=changeme-openscrub-key

# ── APIGuard Integration ──────────────────────────────────────────────────────

# APIGuard API base URL for detection validation polling.
SECURELAB_APIGUARD_URL=https://apiguard.internal

# API key for APIGuard.
SECURELAB_APIGUARD_API_KEY=changeme-apiguard-key

# ── ThreatFlow Integration ────────────────────────────────────────────────────

# ThreatFlow API base URL for IOC detection polling.
SECURELAB_THREATFLOW_URL=https://threatflow.internal

# API key for ThreatFlow.
SECURELAB_THREATFLOW_API_KEY=changeme-threatflow-key

# ── Detection Validation ──────────────────────────────────────────────────────

# How long to wait for a detection event after an attack step completes.
# Increase if your detection platforms have higher latency.
SECURELAB_DETECTION_WINDOW=60s

# ── Environment Safety ────────────────────────────────────────────────────────

# Comma-separated list of blocked target keywords.
# Any environment URL containing these strings will be rejected.
SECURELAB_BLOCKED_TARGETS=production,prod,live,api.company.com

# Maximum number of concurrent attack scenarios.
SECURELAB_MAX_CONCURRENT_RUNS=3

# Default timeout for individual scenario steps.
SECURELAB_DEFAULT_STEP_TIMEOUT=5m
