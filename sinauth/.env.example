# sinauth — SIN Identity Provider
# Copy to .env and fill in values

SINAUTH_HTTP_ADDR=:8100
SINAUTH_DEV_MODE=false

# Database
SINAUTH_DB_URL=postgres://sinauth:sinauth@localhost:5432/sinauth?sslmode=disable
SINAUTH_DB_MAX_CONNS=16

# OIDC
SINAUTH_ISSUER=https://auth.sin.to
SINAUTH_SITE_URL=https://sin.to
SINAUTH_ALLOWED_ORIGINS=https://sin.to,https://apiguard.sin.to

# RSA signing key
SINAUTH_SIGNING_KEY_PATH=/etc/sinauth/keys/sinauth.pem
SINAUTH_SIGNING_KEY_ID=sinauth-1

# Token TTLs
SINAUTH_ACCESS_TOKEN_TTL=1h
SINAUTH_ID_TOKEN_TTL=5m
SINAUTH_REFRESH_TOKEN_TTL=720h

# Security
SINAUTH_BCRYPT_COST=12
SINAUTH_TRUSTED_PROXIES=

# Social OAuth (optional)
# Leave the REDIRECT_URI vars unset to auto-derive them from SINAUTH_ISSUER
# (<issuer>/api/v1/auth/{provider}/callback). If you set them explicitly they
# MUST match both the callback route below and the URL registered in the
# Google / GitHub OAuth app console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth.sin.to/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://auth.sin.to/api/v1/auth/github/callback

# Email (optional — leave empty to disable)
SINAUTH_SMTP_HOST=
SINAUTH_SMTP_PORT=587
SINAUTH_SMTP_USERNAME=
SINAUTH_SMTP_PASSWORD=
SINAUTH_SMTP_FROM=noreply@sin.to
