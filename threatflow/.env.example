# ThreatFlow configuration — copy to .env and fill in values.
# See docs/configuration.md for full reference.

# Core
THREATFLOW_PORT=8091
THREATFLOW_LOG_LEVEL=info
THREATFLOW_LOG_FORMAT=json

# Database (PostgreSQL 16+)
THREATFLOW_DB_URL=postgres://threatflow:threatflow@localhost:5432/threatflow?sslmode=disable
THREATFLOW_DB_MAX_OPEN_CONNS=25
THREATFLOW_DB_MAX_IDLE_CONNS=5

# CITADEL governance (leave empty to disable)
THREATFLOW_CITADEL_API_URL=
THREATFLOW_CITADEL_KEY_ID=
THREATFLOW_CITADEL_KEY_SECRET=
THREATFLOW_CITADEL_PROJECT_ID=threatflow

# Redis (planned — v0.5+)
# THREATFLOW_REDIS_URL=redis://localhost:6379/2

# Authentication (planned)
# THREATFLOW_AUTH_JWT_SECRET=
# THREATFLOW_AUTH_TOKEN_EXPIRY=1h
