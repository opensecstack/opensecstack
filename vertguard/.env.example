# VertGuard configuration — copy to `.env` or export before running.
# See docs/configuration.md for the full reference.

# ── Server ───────────────────────────────────────────────────────────
VERTGUARD_PORT=8091
VERTGUARD_DASHBOARD_PORT=3009
VERTGUARD_LOG_LEVEL=info
VERTGUARD_SERVER_READ_TIMEOUT=30s
VERTGUARD_SERVER_WRITE_TIMEOUT=30s

# ── Database ─────────────────────────────────────────────────────────
VERTGUARD_DB_HOST=localhost
VERTGUARD_DB_PORT=5438
VERTGUARD_DB_NAME=vertguard
VERTGUARD_DB_USER=vertguard
VERTGUARD_DB_PASSWORD=
VERTGUARD_DB_SSL_MODE=disable   # require / verify-full for production
VERTGUARD_DB_MAX_OPEN_CONNS=25
# Minimum idle pool size — keeps a warm floor of connections so the
# first request after a quiet period does not pay TCP+TLS handshake.
VERTGUARD_DB_MIN_CONNS=2

# ── Auth (JWT — HS256) ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
# Empty enables dev mode with loud warning. NEVER empty in production.
VERTGUARD_AUTH_SECRET=
VERTGUARD_AUTH_TOKEN_TTL=8h
VERTGUARD_AUTH_ISSUER=vertguard
VERTGUARD_AUTH_DEV_MODE=false

# ── CITADEL integration ──────────────────────────────────────────────
# Empty URL = standalone mode (no WORM, loud warn at startup)
VERTGUARD_CITADEL_API_URL=http://localhost:8099
# Single-key knob (legacy). For rotation use VERTGUARD_CITADEL_HMAC_SECRETS
# (comma-separated: primary,next,previous) and the matching KEY_IDS list.
VERTGUARD_CITADEL_KEY_ID=
VERTGUARD_CITADEL_KEY_SECRET=
VERTGUARD_CITADEL_HMAC_SECRETS=
VERTGUARD_CITADEL_KEY_IDS=
VERTGUARD_CITADEL_PROJECT_ID=
VERTGUARD_CITADEL_DRY_RUN=false

# ── ThreatFlow integration ───────────────────────────────────────────
VERTGUARD_THREATFLOW_API_URL=http://localhost:8084
VERTGUARD_THREATFLOW_KEY_ID=
VERTGUARD_THREATFLOW_KEY_SECRET=
VERTGUARD_WEBHOOK_THREATFLOW_SECRET=
VERTGUARD_THREATFEED_PUSH_INTERVAL=15m
VERTGUARD_THREATFEED_RECONCILE_CRON="0 4 * * *"
VERTGUARD_THREATFEED_MIN_CONFIDENCE=0.5

# ── Module 3: Prompt Injection ───────────────────────────────────────
VERTGUARD_PROMPT_CLEAN_THRESHOLD=0.3
VERTGUARD_PROMPT_BLOCK_THRESHOLD=0.7
VERTGUARD_PROMPT_MAX_INPUT_SIZE=1048576
VERTGUARD_PROMPT_PATTERN_REGISTRY_PATH=/etc/vertguard/patterns/
VERTGUARD_PROMPT_CUSTOM_PATTERNS_PATH=
# Optional LLM firewall integrations
VERTGUARD_PROMPT_NEMO_ENDPOINT=
VERTGUARD_PROMPT_LLAMAGUARD_ENDPOINT=

# ── Module 4: AI Threat Feed ─────────────────────────────────────────
VERTGUARD_THREATFEED_SOURCES_PATH=/etc/vertguard/sources.yaml
VERTGUARD_THREATFEED_ATLAS_SYNC_CRON="0 0 * * 0"
VERTGUARD_THREATFEED_COMMUNITY_SYNC_CRON="0 6 * * *"
# Override MITRE ATLAS feed URL — defaults to the upstream GitHub raw
# YAML when unset. Set this for air-gapped mirrors or pinned snapshots.
VERTGUARD_ATLAS_SOURCE_URL=

# ── Module 1: C2PA (Phase 4.1 partial) ───────────────────────────────
VERTGUARD_C2PA_TRUSTSTORE=/etc/vertguard/c2pa-truststore
VERTGUARD_C2PA_OCSP_ENABLED=false
VERTGUARD_MEDIA_MAX_SIZE=104857600
VERTGUARD_MEDIA_CONTENT_RETENTION=false

# ── Module 2: AI Phishing (Phase 4.2 — stubs only in v0.1) ───────────
VERTGUARD_PHISHING_ENABLED=false

# ── Module 5: Synthetic Identity (Phase 4.3 — stubs only in v0.1) ────
VERTGUARD_IDENTITY_ENABLED=false
VERTGUARD_IDENTITY_REALTIME_ENABLED=false

# ── Python ML gRPC service (Phase 4.2+) ──────────────────────────────
VERTGUARD_ML_GRPC_URL=localhost:50051
VERTGUARD_ML_MODELS_PATH=/var/lib/vertguard/models/
VERTGUARD_ML_GPU_ENABLED=false
VERTGUARD_ML_MAX_BATCH_SIZE=16

# ── Post-quantum (v1.1+) ─────────────────────────────────────────────
VERTGUARD_PQ_HYBRID_ENABLED=false
VERTGUARD_PQ_REQUIRE_HYBRID=false

# ── Outbound Webhook Dispatcher (VG-015) ─────────────────────────────
VERTGUARD_WEBHOOK_ENABLED=false
VERTGUARD_WEBHOOK_TIMEOUT=5s
VERTGUARD_WEBHOOK_OUTBOX_INTERVAL=5s

# ── Integration testing ──────────────────────────────────────────────
VERTGUARD_TEST_DB_URL=postgres://vertguard:vertguard_test@localhost:54838/vertguard_test?sslmode=disable
